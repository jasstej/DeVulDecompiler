# Render + Neon deployment environment variables
# Import this file in Render via: Environment -> Add from .env

DJANGO_SETTINGS_MODULE=decompiler_explorer.settings.docker

# Generate strong random strings for these in Render (click Generate) or replace below
SECRET_KEY=replace_with_random_long_string
WORKER_AUTH_TOKEN=replace_with_random_long_string

DJANGO_DEBUG=False

# Set to your Render hostname (you can add more comma-separated hosts if needed)
ALLOWED_HOSTS=your-service.onrender.com

# Neon connection string (ensure it includes sslmode=require)
DATABASE_URL=psql 'postgresql://neondb_owner:npg_9sQJH6fLUInp@ep-shy-thunder-adwugz5l-pooler.c-2.us-east-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require'

# Optional: if using Django admin/login over HTTPS
# CSRF_TRUSTED_ORIGINS=https://your-service.onrender.com

# Optional: S3-backed media storage (uncomment and fill to enable)
# DJANGO_FILE_STORAGE=storages.backends.s3boto3.S3Boto3Storage
# AWS_STORAGE_BUCKET_NAME=your-bucket
# AWS_S3_ENDPOINT_URL=https://s3.your-provider.tld
# AWS_S3_REGION_NAME=us-east-1
# AWS_ACCESS_KEY_ID=your-key
# AWS_SECRET_ACCESS_KEY=your-secret
